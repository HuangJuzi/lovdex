# Lovdex Frontend UI — Environment Configuration
#
# This repo is now the frontend only. It talks to the standalone backend
# (lovdex-backend) over HTTP + WebSocket. Configure the backend address below
# and make sure the backend's CORS_ORIGIN includes this frontend's origin.

# =============================================================================
# FRONTEND SERVER (Vite dev / preview)
# =============================================================================
# Port for the Vite dev server
VITE_PORT=5187
# Host/IP to bind the dev server to (0.0.0.0 = all interfaces)
HOST=0.0.0.0

# =============================================================================
# BACKEND CONNECTION
# =============================================================================
# Port of the standalone backend (used by the Vite dev proxy for /api and /ws).
# Must match the backend's SERVER_PORT. Backend default = 3001.
SERVER_PORT=3001

# Base URL of the backend API. Leave empty for same-origin (dev proxy / reverse
# proxy). Set to an absolute URL to call the backend cross-origin,
# e.g. VITE_API_BASE_URL=http://localhost:3001
VITE_API_BASE_URL=

# =============================================================================
# MISC
# =============================================================================
# Platform mode flag (hosted vs self-host)
VITE_IS_PLATFORM=false
# Claude Code context window size (maximum tokens per session)
VITE_CONTEXT_WINDOW=160000
