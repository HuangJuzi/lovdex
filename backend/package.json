{
  "name": "lovdex-backend",
  "version": "1.0.0",
  "description": "Standalone backend service (Express API + WebSocket) for Lovdex — serves any frontend/business that speaks its API.",
  "type": "module",
  "main": "dist-server/server/index.js",
  "scripts": {
    "dev": "tsx --tsconfig server/tsconfig.json server/index.js",
    "dev:watch": "tsx watch --tsconfig server/tsconfig.json server/index.js",
    "start": "node dist-server/server/index.js",
    "prebuild": "node -e \"require('node:fs').rmSync('dist-server', { recursive: true, force: true })\"",
    "build": "tsc -p server/tsconfig.json && tsc-alias -p server/tsconfig.json",
    "typecheck": "tsc --noEmit -p server/tsconfig.json",
    "lint": "eslint server/",
    "lint:fix": "eslint server/ --fix"
  },
  "keywords": [
    "claude-code",
    "codex",
    "anthropic",
    "openai",
    "coding-agent",
    "api",
    "backend"
  ],
  "author": "Lovdex",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.165",
    "@iarna/toml": "^2.2.5",
    "@openai/codex-sdk": "^0.144.0",
    "@vscode/ripgrep": "^1.17.1",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "croner": "^10.0.1",
    "cross-spawn": "^7.0.3",
    "express": "^4.18.2",
    "gray-matter": "^4.0.3",
    "mime-types": "^3.0.1",
    "multer": "^2.0.1",
    "node-pty": "^1.1.0",
    "ws": "^8.14.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.19.7",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.3",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "node-gyp": "^12.4.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
