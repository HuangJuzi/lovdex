# Lovdex Standalone Backend — Environment Configuration
# Copy to .env and adjust. This service is a pure API + WebSocket server;
# it does NOT serve any frontend bundle. Point your frontend at it via
# VITE_API_BASE_URL=http://<host>:<port> (and configure CORS_ORIGIN below).

# =============================================================================
# SERVER
# =============================================================================
# Backend server port (Express API + WebSocket). Default in code is 3001.
SERVER_PORT=3001
# Host/IP to bind to (0.0.0.0 = all interfaces; 127.0.0.1 = localhost only)
HOST=0.0.0.0

# CORS: allowed origins for cross-origin frontends/business services.
# "*" = any origin (default). Single origin: http://localhost:5187
# Allowlist (comma-separated): http://localhost:5187,https://app.example.com
CORS_ORIGIN=*

# =============================================================================
# DATABASE
# =============================================================================
# Path to the auth/config database file. Defaults to ~/.cloudcli/auth.db if unset.
# DATABASE_PATH=/path/to/your/custom/auth.db

# =============================================================================
# AUTH (email + verification code login gate)
# =============================================================================
# Set AUTH_ENABLED=false to revert to the open no-login mode (safety valve).
# Default true.
# AUTH_ENABLED=true
# The login credentials (email / verification code / JWT signing key) are NOT
# env vars — they live in the config file:
#   server/modules/auth/auth.config.json
# Edit that file to change who can log in (defaults: zhiju.huang@sophgo.com /
# 888888 / lovdex@2026).

# =============================================================================
# PROVIDERS
# =============================================================================
# Custom claude CLI path (defaults to "claude")
# CLAUDE_CLI_PATH=claude

# Claude Code context window size (max tokens per session)
CONTEXT_WINDOW=160000

# =============================================================================
# MISC
# =============================================================================
# Platform mode flag (read by server/constants/config.js). Leave false for self-host.
VITE_IS_PLATFORM=false

# =============================================================================
# WORKFLOW
# =============================================================================
# Workflow feature (Claude Agent SDK). Defaults match SDK defaults.
WORKFLOWS_ENABLED=true
ULTRACODE_KEYWORD_TRIGGER=true
