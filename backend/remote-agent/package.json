    "test": "tsx --test src/tests/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.113",
    "ws": "^8.14.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "esbuild": "^0.21.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
